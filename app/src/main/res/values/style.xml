<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="InputBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@android:color/darker_gray</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorHint">#888888</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="PriceBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chips</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- FIXED -->
    <style name="InputMulti">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- FIXED -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>

    <!-- FIXED -->
    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#AAAAAA</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input2</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorHint">#6F6F6F</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>


    <style name="InputMultiline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:gravity">top</item>
        <item name="android:background">@drawable/bg_input2</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorHint">#6F6F6F</item>
        <item name="android:padding">14dp</item>
    </style>


    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#2A2A2A</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>


    <style name="Chip">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textSize">11.5sp</item>
    </style>


    <style name="ChipCircle">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_chip_circle</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>

</resources>
