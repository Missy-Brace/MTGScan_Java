<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        app:titleTextColor="@android:color/white"
        app:navigationIconTint="@color/orange"
        app:itemIconTint="@color/orange" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- IMAGE + FLIP -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />


                <ImageButton
                    android:id="@+id/btnFlip"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="@color/orange" />
            </FrameLayout>


            <LinearLayout
                android:id="@+id/layoutBasic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_dark"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="Basic"
                    android:textColor="@color/orange"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtBasic"
                    android:textColor="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutTypeMana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="Type &amp; Mana"
                    android:textColor="@color/orange"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtTypeMana"
                    android:textColor="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_dark"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="Stats"
                    android:textColor="@color/orange"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtStats"
                    android:textColor="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_dark"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="Rules"
                    android:textColor="@color/orange"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtRules"
                    android:textColor="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutFlavor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_dark"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="Flavor"
                    android:textColor="@color/orange"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtFlavor"
                    android:textColor="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLegalities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_dark"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvLegalitiesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Legalities"
                    android:textColor="@color/orange"
                    android:textSize="18sp"
                    android:textStyle="bold"/>


                <TextView
                    android:id="@+id/tvLegal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Legal"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layoutLegal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:flexDirection="row"
                    app:flexWrap="wrap"/>



                <TextView
                    android:id="@+id/tvNotLegal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not legal"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layoutNotLegal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:flexDirection="row"
                    app:flexWrap="wrap"/>


            </LinearLayout>




            <LinearLayout
                android:id="@+id/layoutPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_dark"
                android:layout_marginBottom="16dp">

                <TextView
                    android:text="Price"
                    android:textColor="@color/orange"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/txtUsd"
                        style="@style/PriceBox"
                        android:text="USD\n$0.00"/>

                    <TextView
                        android:id="@+id/txtFoil"
                        style="@style/PriceBox"
                        android:text="Foil\n$0.00"/>

                    <TextView
                        android:id="@+id/txtEur"
                        style="@style/PriceBox"
                        android:text="EUR\n€0.00"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPriceAsOf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="As of: —"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>





            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
