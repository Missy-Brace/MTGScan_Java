<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:paddingTop="0dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Search"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_search"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- Camera container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_camera_rounded">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

<!--        <com.example.mtg_java.scanner.LiveDebugOverlay-->
<!--            android:id="@+id/liveOverlay"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="match_parent" />-->

        <View
            android:id="@+id/cardOverlay"
            android:layout_width="340dp"
            android:layout_height="240dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/overlay_frame" />

        <View
            android:id="@+id/cardNameOverlay"
            android:layout_width="355dp"
            android:layout_height="30dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/overlay_frame" />

        <View
            android:id="@+id/cardTypeOverlay"
            android:layout_width="355dp"
            android:layout_height="30dp"
            android:layout_gravity="center|center_horizontal"
            android:layout_marginTop="45dp"
            android:background="@drawable/overlay_frame" />

    </FrameLayout>


    <!-- Helper text -->

    <!-- Gallery button -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:padding="16dp"
        android:text="Align your card in the frame to scan automatically."
        android:textColor="#BBBBBB" />

</LinearLayout>
