<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- PROFILE LABEL -->
        <TextView
            android:text="Profile"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- PROFILE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card">

            <!-- PROFILE ROW -->
            <LinearLayout
                android:id="@+id/rowProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:src="@drawable/ic_user"
                    android:tint="#AAAAAA"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtUsername"
                        android:textColor="#FFFFFF"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/txtEmail"
                        android:textColor="#888888"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:textSize="14sp"/>
                </LinearLayout>

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#777777"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_settings"/>

            <!-- CHANGE PASSWORD -->
            <LinearLayout
                android:id="@+id/rowChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:src="@drawable/ic_key"
                    android:tint="#AAAAAA"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>

                <TextView
                    android:text="Change password"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#777777"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DATA SECTION -->
        <TextView
            android:text="Data"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/rowClearCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:padding="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:src="@drawable/ic_trash"
                android:tint="#AAAAAA"
                android:layout_width="24dp"
                android:layout_height="24dp"/>

            <TextView
                android:text="Clear cache"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"/>

            <ImageView
                android:src="@drawable/ic_arrow_right"
                android:tint="#777777"
                android:layout_width="18dp"
                android:layout_height="18dp"/>
        </LinearLayout>

        <!-- ACCOUNT SECTION -->
        <TextView
            android:text="Account"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card">

            <!-- LOG OUT -->
            <LinearLayout
                android:id="@+id/rowLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:src="@drawable/ic_logout"
                    android:tint="#AAAAAA"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>

                <TextView
                    android:text="Log out"
                    android:textColor="#FF5A1F"
                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#777777"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_settings"/>

            <!-- DELETE ACCOUNT -->
            <LinearLayout
                android:id="@+id/rowDeleteAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:src="@drawable/ic_warning"
                    android:tint="#AAAAAA"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>

                <TextView
                    android:text="Delete account"
                    android:textColor="#FF4D4D"
                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#777777"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>