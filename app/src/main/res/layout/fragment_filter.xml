<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <RelativeLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/btnClose"
            android:text="✕"
            android:textColor="#FF6A00"
            android:textSize="22sp"
            android:layout_alignParentStart="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Advanced Search"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Card Text & Set -->
            <TextView style="@style/SectionTitle"
                android:text="Card Text &amp; Set"
                android:layout_marginBottom="12dp"/>

            <TextView style="@style/Label"
                android:text="Name"
                android:layout_marginBottom="5dp"/>

            <EditText
                android:id="@+id/fName"
                style="@style/Input"
                android:hint="Card Name"
                android:layout_marginBottom="15dp"/>

            <TextView style="@style/Label"
                android:text="Text"
                android:layout_marginBottom="5dp"/>

            <EditText
                android:id="@+id/fText"
                style="@style/InputMultiline"
                android:hint="Text in the text box"
                android:layout_marginBottom="25dp"/>

            <View style="@style/Divider"
                android:layout_marginBottom="20dp"/>

            <!-- Types -->
            <TextView style="@style/SectionTitle"
                android:text="Types"
                android:layout_marginBottom="12dp"/>

            <TextView style="@style/Label"
                android:text="Type"
                android:layout_marginBottom="5dp"/>

            <EditText
                android:id="@+id/fType"
                style="@style/Input"
                android:hint="e.g. Creature, Instant..."
                android:layout_marginBottom="20dp"/>

            <View style="@style/Divider"
                android:layout_marginBottom="20dp"/>

            <!-- Color & Mana -->
            <TextView style="@style/SectionTitle"
                android:text="Color &amp; Mana"
                android:layout_marginBottom="12dp"/>

            <TextView style="@style/Label"
                android:text="Color"
                android:layout_marginBottom="9dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <ToggleButton android:id="@+id/cW" style="@style/ChipCircle" android:textOn="W" android:textOff="W"/>
                <ToggleButton android:id="@+id/cU" style="@style/ChipCircle" android:textOn="U" android:textOff="U"/>
                <ToggleButton android:id="@+id/cB" style="@style/ChipCircle" android:textOn="B" android:textOff="B"/>
                <ToggleButton android:id="@+id/cR" style="@style/ChipCircle" android:textOn="R" android:textOff="R"/>
                <ToggleButton android:id="@+id/cG" style="@style/ChipCircle" android:textOn="G" android:textOff="G"/>
            </LinearLayout>



            <!-- Color Identity -->
            <TextView style="@style/Label"
                android:text="Color Identity"
                android:layout_marginBottom="9dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <ToggleButton android:id="@+id/idW" style="@style/ChipCircle" android:textOn="W" android:textOff="W"/>
                <ToggleButton android:id="@+id/idU" style="@style/ChipCircle" android:textOn="U" android:textOff="U"/>
                <ToggleButton android:id="@+id/idB" style="@style/ChipCircle" android:textOn="B" android:textOff="B"/>
                <ToggleButton android:id="@+id/idR" style="@style/ChipCircle" android:textOn="R" android:textOff="R"/>
                <ToggleButton android:id="@+id/idG" style="@style/ChipCircle" android:textOn="G" android:textOff="G"/>
            </LinearLayout>

            <TextView style="@style/Label"
                android:text="Mana Cost (CMC)"
                android:layout_marginBottom="5dp"/>

            <EditText
                android:id="@+id/fMana"
                style="@style/Input"
                android:hint="Exact converted mana value"
                android:layout_marginBottom="25dp"/>
            <View style="@style/Divider"
                />

            <!-- Rarity & Artist -->
            <TextView style="@style/SectionTitle"
                android:text="Rarity &amp; Artist"
                android:layout_marginBottom="12dp"/>



            <TextView style="@style/Label"
                android:text="Rarity"
                android:layout_marginBottom="5dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <ToggleButton
                    android:id="@+id/rCommon"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"

                    android:layout_marginHorizontal="2dp"
                    android:textOn="Common"
                    android:textOff="Common"/>

                <ToggleButton
                    android:id="@+id/rUncommon"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:textOn="Uncommon"
                    android:textOff="Uncommon"/>

                <ToggleButton
                    android:id="@+id/rRare"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:textOn="Rare"
                    android:textOff="Rare"/>

                <ToggleButton
                    android:id="@+id/rMythic"
                    style="@style/Chip"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:textOn="Mythic"
                    android:textOff="Mythic"/>
            </LinearLayout>


            <TextView style="@style/Label"
                android:text="Artist"
                android:layout_marginBottom="5dp"/>

            <EditText
                android:id="@+id/fArtist"
                style="@style/Input"
                android:hint="Artist name"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:padding="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp">

        <TextView
            android:id="@+id/tvSummary"
            android:text="No filters selected"
            android:textColor="#AAA"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnClear"
            android:text="Clear All"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingHorizontal="20dp"
            android:textSize="14sp"
            android:backgroundTint="#444"
            android:textColor="@android:color/white"/>
        <Button
            android:id="@+id/btnSearch"
            android:text="Search"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingHorizontal="20dp"
            android:textSize="14sp"
            android:backgroundTint="#FF6A00"
            android:textColor="@android:color/white"
            android:layout_marginStart="12dp"/>




    </LinearLayout>

</LinearLayout>
